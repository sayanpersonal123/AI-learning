{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "genesis-atlas-puce.vercel.app" }],
      "destination": "https://atlas.sayangupta.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "genesis-atlas-sayan-guptas-projects-db1f000d.vercel.app" }],
      "destination": "https://atlas.sayangupta.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "genesis-atlas-git-main-sayan-guptas-projects-db1f000d.vercel.app" }],
      "destination": "https://atlas.sayangupta.in/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
