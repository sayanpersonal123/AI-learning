{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "genesis-atlas-puce.vercel.app"
        }
      ],
      "destination": "https://atlas.sayangupta.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "genesis-atlas-sayan-guptas-projects-db1f000d.vercel.app"
        }
      ],
      "destination": "https://atlas.sayangupta.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "genesis-atlas-git-main-sayan-guptas-projects-db1f000d.vercel.app"
        }
      ],
      "destination": "https://atlas.sayangupta.in/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
